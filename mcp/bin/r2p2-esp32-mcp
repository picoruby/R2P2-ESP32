#!/usr/bin/env ruby
# frozen_string_literal: true

# Starts the MCP server. stdout carries the MCP protocol, so problems are reported on stderr.

MCP_DIR = File.expand_path('..', __dir__)
ENV['BUNDLE_GEMFILE'] ||= File.join(MCP_DIR, 'Gemfile')

def abort_with_setup_hint(reason)
  warn <<~MESSAGE
    r2p2-esp32-mcp: cannot start: #{reason}

    Install the gems it needs once (with the same Ruby the MCP client starts), then restart the server:

      cd #{MCP_DIR} && bundle install

    Ruby in use: #{RUBY_VERSION} (#{RbConfig.ruby})
    Details: #{File.join(MCP_DIR, 'README.md')}
  MESSAGE
  exit 1
end

begin
  require 'bundler'
  Bundler.setup(:default) # the server does not need the development group (rubocop)
rescue LoadError
  abort_with_setup_hint('Bundler is not available for this Ruby')
rescue StandardError => e
  raise unless e.is_a?(Bundler::BundlerError)

  abort_with_setup_hint(e.is_a?(Bundler::GemNotFound) ? 'the gems it needs are not installed' : e.message)
end

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'r2p2_mcp'

R2p2Mcp::Server.run
